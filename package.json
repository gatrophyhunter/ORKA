{
  "name": "orka",
  "private": true,
  "version": "0.1.0",
  "description": "ORKA \u2014 open handload prediction: interior ballistics, pressure limits, parametric powder search, sourced component database",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "e2e": "node scripts/e2e-smoke.cjs",
    "data": "tsx scripts/build-data.ts && tsx scripts/calibrate-powders.ts && tsx scripts/build-data.ts"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
